{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Caspian Race Monitor",
  "version": "1.4.55",
  "identifier": "com.caspianmotorsport.racemonitor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Caspian Race Monitor",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "externalBin": ["binaries/caspian-bridge"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ahmettdc/caspianracemonitorweb/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2NkQ1RkQxMkZBMTcwNEUKUldST2NLRXYwVjl0dGo0VThkajY1NExhRnJuY1NPVExTeWVWQkloeW14M1ArM1RqRjJna1VNMmIK"
    }
  }
}
