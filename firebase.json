{
  "database": {
    "rules": "firebase-rules.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "database": { "port": 9000 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
