{
  "rules": {
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('admin').val() == true",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('admin').val() == true)",
        ".validate": "root.child('users').child(auth.uid).child('admin').val() == true || (newData.child('allowed').val() == data.child('allowed').val() && newData.child('admin').val() == data.child('admin').val())"
      }
    },

    "userAvatars": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('allowed').val() == true",
      "$uid": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('allowed').val() == true && (auth.uid == $uid || root.child('users').child(auth.uid).child('admin').val() == true)",
        ".validate": "newData.isString() && newData.val().length < 60000"
      }
    },

    "rooms": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('allowed').val() == true",
      ".write": "auth != null && root.child('users').child(auth.uid).child('allowed').val() == true"
    },

    "teamCodes": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('allowed').val() == true",
      "$code": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('allowed').val() == true && (!data.exists() || (!newData.exists() && root.child('teams').child(data.val()).child('members').child(auth.uid).val() == 'owner'))"
      }
    },

    "globalSetups": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('allowed').val() == true",
      "$id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('allowed').val() == true && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && root.child('users').child(auth.uid).child('admin').val() == true))",
        ".validate": "newData.child('uid').val() == auth.uid && (!newData.child('data').exists() || (newData.child('data').isString() && newData.child('data').val().length < 260000))"
      }
    },

    "globalSetupData": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('allowed').val() == true",
      "$id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('allowed').val() == true && ((!data.exists() && newData.exists() && newData.child('uid').val() == auth.uid) || (data.exists() && !newData.exists() && root.child('users').child(auth.uid).child('admin').val() == true))",
        ".validate": "newData.child('uid').val() == auth.uid && newData.child('data').isString() && newData.child('data').val().length < 260000"
      }
