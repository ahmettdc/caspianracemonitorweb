{
  "rules": {
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('admin').val() == true",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('admin').val() == true)",
        ".validate": "root.child('users').child(auth.uid).child('admin').val() == true || (newData.child('allowed').val() == data.child('allowed').val() && newData.child('admin').val() == data.child('admin').val())"
      }
    },
    "rooms": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('allowed').val() == true",
      ".write": "auth != null && root.child('users').child(auth.uid).child('allowed').val() == true"
    },
    "teamCodes": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('allowed').val() == true",
      "$code": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('allowed').val() == true && !data.exists()"
      }
    },
    "teams": {
      "$tid": {
        "meta": {
          ".read": "auth != null && root.child('teams').child($tid).child('members').child(auth.uid).exists()",
          ".write": "auth != null && (!data.exists() || data.child('ownerUid').val() == auth.uid)"
        },
        "members": {
          ".read": "auth != null && data.child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && ((auth.uid == $uid && !data.exists() && newData.val() == 'viewer') || (auth.uid == $uid && !newData.exists()) || root.child('teams').child($tid).child('members').child(auth.uid).val() == 'owner' || !root.child('teams').child($tid).child('meta').exists())"
          }
        },
        "badges": {
          ".read": "auth != null && root.child('teams').child($tid).child('members').child(auth.uid).exists()",
          ".write": "auth != null && root.child('teams').child($tid).child('members').child(auth.uid).val() == 'owner'"
        },
        "seasons": {
          ".read": "auth != null && root.child('teams').child($tid).child('members').child(auth.uid).exists()",
          ".write": "auth != null && (root.child('teams').child($tid).child('members').child(auth.uid).val() == 'owner' || root.child('teams').child($tid).child('members').child(auth.uid).val() == 'editor')"
        },
        "races": {
          ".read": "auth != null && root.child('teams').child($tid).child('members').child(auth.uid).exists()",
          ".write": "auth != null && (root.child('teams').child($tid).child('members').child(auth.uid).val() == 'owner' || root.child('teams').child($tid).child('members').child(auth.uid).val() == 'editor')"
        },
        "raceState": {
          ".read": "auth != null && root.child('teams').child($tid).child('members').child(auth.uid).exists()",
          ".write": "auth != null && (root.child('teams').child($tid).child('members').child(auth.uid).val() == 'owner' || root.child('teams').child($tid).child('members').child(auth.uid).val() == 'editor')"
        }
      }
    }
  }
}